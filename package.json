{
  "name": "setuno",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "eas-build-pre-install": "node scripts/ensure-firebase-config.mjs",
    "typecheck": "tsc --noEmit && pnpm --dir functions run typecheck",
    "e2e:setup": "node scripts/e2eSetup.mjs",
    "e2e": "maestro test e2e/journey.yaml",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "deploy:rules": "npx firebase-tools@latest deploy --only firestore:rules",
    "deploy:indexes": "npx firebase-tools@latest deploy --only firestore:indexes",
    "deploy:storage": "npx firebase-tools@latest deploy --only storage",
    "deploy:functions": "pnpm --dir functions run build && npx firebase-tools@latest deploy --only functions",
    "serve:functions": "pnpm --dir functions run build && npx firebase-tools@latest emulators:start --only functions,firestore",
    "backup:status": "node scripts/firestoreBackup.mjs status",
    "backup:wait": "node scripts/firestoreBackup.mjs wait",
    "backup:drill": "node scripts/firestoreBackup.mjs drill",
    "backup:cleanup": "node scripts/firestoreBackup.mjs cleanup",
    "export:web": "node scripts/ensure-firebase-config.mjs && expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@firebase/auth": "^1.13.6",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "26.4.0",
    "@react-native-firebase/storage": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tombatossals/chords-db": "^0.5.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^5.8.2",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "jszip": "^3.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "~7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-localize": "^3.7.2",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "~15.15.5",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "~0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@napi-rs/canvas": "^1.0.10",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
