{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-staging": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_ENV": "staging" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "preview-staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_ENV": "staging" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
