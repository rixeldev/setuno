# Copy to `.env` and fill in the values you need. EXPO_PUBLIC_* values are
# embedded in the bundle at build time (they are public, never put secrets
# here): restart with `npx expo start -c` or rebuild after changing them.

# Google Sign-In (Android). Firebase Console -> Authentication -> Sign-in
# method -> Google -> Web SDK configuration -> Web client ID.
# With it, the ID token travels in the native sign-in response, so the flow
# skips the extra `getTokens()` network call. Without it, sign-in still works
# through the access token, just slower.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional AdMob banner unit override for release builds.
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Public web address of the deployment (roadmap #56, native builds only):
# share links open the public /share/<token> page, and a phone build has no
# browser origin to derive it from. The web build always uses its own origin.
# EXPO_PUBLIC_WEB_BASE_URL=https://your-app.example

# Build-time only: `scripts/ensure-firebase-config.mjs` generates
# db/firebaseConfig.ts from these when the file does not exist (e.g. on
# Vercel). Local development usually keeps its own db/firebaseConfig.ts.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
# APP_VERSION_ID=
# ADMOB_BANNER_ID=
# ADMOB_INTERSTITIAL_ID=

# Staging environment (roadmap #80 / P0.7): set APP_ENV=staging for the run
# and the generator switches to the FIREBASE_STAGING_* names below (loaded
# from the gitignored .env.staging locally, from the EAS `preview`
# environment in the cloud) — never both halves at once. The native config
# swaps with it: app.config.js points at google-services-staging.json /
# GoogleService-Info-staging.plist (or the GOOGLE_SERVICES_JSON_STAGING /
# GOOGLE_SERVICES_PLIST_STAGING file-type EAS variables). Staging leaves
# APP_VERSION_ID and the ADMOB_* units empty on purpose: no update gate,
# no ads.
# APP_ENV=staging
# FIREBASE_STAGING_API_KEY=
# FIREBASE_STAGING_AUTH_DOMAIN=
# FIREBASE_STAGING_DATABASE_URL=
# FIREBASE_STAGING_PROJECT_ID=
# FIREBASE_STAGING_STORAGE_BUCKET=
# FIREBASE_STAGING_MESSAGING_SENDER_ID=
# FIREBASE_STAGING_APP_ID=
# FIREBASE_STAGING_MEASUREMENT_ID=

# E2E harness (roadmap #75 / P0.8): the Maestro journey signs in on STAGING,
# so it needs its own account — never reuse a real one. Put these two lines in
# the gitignored .env.e2e (or export them) and run `pnpm e2e:setup` once to
# create the account and its band; CI reads the same names from secrets.
# E2E_EMAIL=
# E2E_PASSWORD=
