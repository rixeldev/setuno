# Copy to `.env` and fill in the values you need. EXPO_PUBLIC_* values are
# embedded in the bundle at build time (they are public, never put secrets
# here): restart with `npx expo start -c` or rebuild after changing them.

# Google Sign-In (Android). Firebase Console -> Authentication -> Sign-in
# method -> Google -> Web SDK configuration -> Web client ID.
# With it, the ID token travels in the native sign-in response, so the flow
# skips the extra `getTokens()` network call. Without it, sign-in still works
# through the access token, just slower.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional AdMob banner unit override for release builds.
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Build-time only: `scripts/ensure-firebase-config.mjs` generates
# db/firebaseConfig.ts from these when the file does not exist (e.g. on
# Vercel). Local development usually keeps its own db/firebaseConfig.ts.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
# APP_VERSION_ID=
# ADMOB_BANNER_ID=
# ADMOB_INTERSTITIAL_ID=
