rules_version = '2';

/**
 * Setuno — Firestore security rules (docs §23).
 *
 * Model recap:
 *   users/{uid}                                     profile + preferences
 *   users/{uid}/organizations/{organizationId}      membership index (role)
 *   users/{uid}/readerState/{songId}                private per-song reader state
 *   users/{uid}/annotations/{songId}                private per-song annotations
 *   users/{uid}/favorites/{songId}                 private star, one doc per song
 *   users/{uid}/collections/{collectionId}          private setlist drafts
 *   users/{uid}/devices/{expo push token}           push registration, one doc per install (#52)
 *   organizations/{organizationId}                  the band
 *   organizations/{organizationId}/members/{uid}
 *   organizations/{organizationId}/songs
 *   organizations/{organizationId}/setlists
 *   organizations/{organizationId}/performances
 *   organizations/{organizationId}/performances/{performanceId}/tasks
 *   organizations/{organizationId}/datePolls
 *   organizations/{organizationId}/datePolls/{pollId}/votes
 *   organizations/{organizationId}/checklists
 *   organizations/{organizationId}/suggestions
 *   organizations/{organizationId}/suggestions/{suggestionId}/comments
 *   organizations/{organizationId}/activity
 *   organizations/{organizationId}/invitations/{lowercased email}
 *   organizations/{organizationId}/joinRequests/{uid}  a musician asking to join (#60)
 *   discoverable/{organizationId}                      opt-in directory: name only (#60)
 *   shares/{token}                                    public share snapshot (#56)
 *
 * Invariants enforced here:
 *   • any roster member can read the band's music and logistics, the read-only
 *     `guest` role included (roadmap #59) — while suggestions, their comments,
 *     the activity feed, date polls and the checklist library stay plain-member:
 *     a guest reads the night, not the band's conversation;
 *   • only admins can write the *content* of songs, setlists or performances —
 *     members get two narrow event carve-outs (roadmap #45/#47): the show log
 *     and their own attendance answer, plus the event's tasks, which any
 *     member ticks (logistics is not an admin job) — and a guest gets none of
 *     them: `isMember` never counts a guest (#59);
 *   • any plain member can create a suggestion, nobody can edit a song directly;
 *   • nobody can change their own role, admins included;
 *   • membership is granted through an email-keyed invitation that only the
 *     matching authenticated account can accept, in the same batch that creates
 *     the membership — a join request (roadmap #60) can only ever *mint* that
 *     invitation: approving never grants membership directly;
 *   • discoverability is opt-in and name-only (roadmap #60): the
 *     `discoverable/{organizationId}` entry exists only while the band's own
 *     `discoverable` flag says so — the two move in one batch or the write is
 *     denied — and it carries the band's name, never emails, uids or rosters;
 *   • `users/{uid}` is private: no client can look up another person's account,
 *     which is what keeps invite-by-email honest;
 *   • `shares/{token}` is the only anonymous read: a public link works signed
 *     out, dies at its deadline, and can never be listed or written by a client
 *     (roadmap #56).
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    /** Lowercased email on the auth token; the invitation key is built from it. */
    function tokenEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function memberPath(organizationId, uid) {
      return /databases/$(database)/documents/organizations/$(organizationId)/members/$(uid);
    }

    function organizationPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId);
    }

    function directoryPath(organizationId) {
      return /databases/$(database)/documents/discoverable/$(organizationId);
    }

    /**
     * The `discoverable` flag and the `discoverable/{organizationId}` entry are
     * one fact in two documents (roadmap #60): the flag may only move in the
     * same batch that publishes the entry (true) or deletes it (false), so the
     * pair can never drift. `getAfter`/`existsAfter` see the post-batch state.
     */
    function discoverableFlagMatchesDirectory(organizationId, before, after) {
      return (after.get('discoverable', false) == before.get('discoverable', false))
        || (after.get('discoverable', false) == true
            && existsAfter(directoryPath(organizationId))
            && getAfter(directoryPath(organizationId)).data.name is string)
        || (after.get('discoverable', false) == false
            && !existsAfter(directoryPath(organizationId)));
    }

    function invitationPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/invitations/$(tokenEmail());
    }

    /** `get()` sees the state *before* a batch, so roles are read per request. */
    function roleOf(organizationId) {
      return exists(memberPath(organizationId, request.auth.uid))
        ? get(memberPath(organizationId, request.auth.uid)).data.role
        : null;
    }

    function isMember(organizationId) {
      return signedIn() && roleOf(organizationId) in ['admin', 'member'];
    }

    function isAdmin(organizationId) {
      return signedIn() && roleOf(organizationId) == 'admin';
    }

    /**
     * Any roster member, guests included (roadmap #59): the **read** gate for
     * the band's music and logistics — songs, setlists, events, their tasks.
     * `isMember` above keeps its write meaning exactly as it was, so every
     * member-writable carve-out below stays closed to the read-only guest.
     */
    function isBandReader(organizationId) {
      return signedIn() && roleOf(organizationId) in ['admin', 'member', 'guest'];
    }

    /**
     * The "current position" of a public live setlist (roadmap #57): the
     * exact shape a member's client may write onto `shares/{token}` — and
     * `null` to clear it. The reader stamps `updatedAt` with client time (a
     * server timestamp would be null while an offline write queues, and the
     * fan page judges staleness off this field).
     */
    function validShareLive(v) {
      return v == null
        || (v is map
          && v.keys().hasOnly(['songId', 'position', 'updatedAt'])
          && v.songId is string
          && v.songId.size() > 0
          && v.songId.size() <= 128
          && v.position is int
          && v.position >= 1
          && v.position <= 500
          && v.updatedAt is int
          && v.updatedAt > 0);
    }

    /** The event's pointer at its live link (roadmap #57): token + list. */
    function validLiveShare(v) {
      return v == null
        || (v is map
          && v.keys().hasOnly(['token', 'setlistId'])
          && v.token is string
          && v.token.size() > 0
          && v.token.size() <= 256
          && v.setlistId is string
          && v.setlistId.size() > 0
          && v.setlistId.size() <= 128);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Creating the band and the owner's own membership happen in one batch, so
     * the membership check has to look at the post-batch organization.
     */
    function isBandOwnerAfterBatch(organizationId) {
      return getAfter(organizationPath(organizationId)).data.ownerId == request.auth.uid;
    }

    /** Accepting an invitation creates the membership in the same batch. */
    function acceptedOwnInvitationAfterBatch(organizationId) {
      return getAfter(invitationPath(organizationId)).data.status == 'accepted';
    }

    /**
     * True while the band's owner deletes the whole band in this batch. The
     * delete flow removes the memberships and the activity feed in the same
     * transaction that deletes the organization itself.
     */
    function ownerIsDeletingOrganization(organizationId) {
      return signedIn()
        && get(organizationPath(organizationId)).data.ownerId == request.auth.uid
        && getAfter(organizationPath(organizationId)) == null;
    }

    function validEmail(address) {
      return address is string && address.size() > 3 && address.size() <= 320
        && address.lower() == address
        && address.matches('.*@.*');
    }

    /**
     * Personal reader state of one song (`users/{uid}/readerState/{songId}`):
     * autoscroll settings plus the resume point (scroll position, transpose,
     * capo and text size, roadmap #1/#4/#5). Add any new field to this list and
     * to `validReaderState`, or the write is rejected.
     */
    function readerStateKeys() {
      return ['autoscrollSpeed', 'autoscrollDelay', 'scrollRatio', 'semitones', 'capo', 'fontSize'];
    }

    function validReaderState() {
      return request.resource.data.keys().hasOnly(readerStateKeys())
        && request.resource.data.get('autoscrollSpeed', 0) is number
        && request.resource.data.get('autoscrollDelay', 0) is number
        && request.resource.data.get('scrollRatio', 0) is number
        && request.resource.data.get('scrollRatio', 0) >= 0
        && request.resource.data.get('scrollRatio', 0) <= 1
        && request.resource.data.get('semitones', 0) is number
        && request.resource.data.get('semitones', 0) >= -11
        && request.resource.data.get('semitones', 0) <= 11
        && request.resource.data.get('capo', 0) is number
        && request.resource.data.get('capo', 0) >= 0
        && request.resource.data.get('capo', 0) <= 12
        && request.resource.data.get('fontSize', 13) is number
        && request.resource.data.get('fontSize', 13) >= 13
        && request.resource.data.get('fontSize', 13) <= 30;
    }

    /**
     * Personal song annotations (`users/{uid}/annotations/{songId}`, roadmap
     * #3). Owner-only, like the reader state: the band never reads another
     * member's notes, and none of it is ever written to the shared song
     * document. Markers are a list, so the rules pin the document-level shape
     * (types, sizes, limits) and leave each entry's contents to the client —
     * the rules language cannot iterate a list.
     */
    function annotationKeys() {
      return ['notes', 'markers', 'updatedAt'];
    }

    function validAnnotation() {
      return request.resource.data.keys().hasOnly(annotationKeys())
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 2000
        && request.resource.data.get('markers', []) is list
        && request.resource.data.get('markers', []).size() <= 50
        && request.resource.data.get('updatedAt', null) is timestamp;
    }

    // -------------------------------------------------------------------- users

    match /users/{uid} {
      // A profile is private: band membership is read through
      // `organizations/{id}/members`, never from here.
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'organizationIds',
          'activeOrganizationId', 'preferences', 'onboarded', 'createdAt', 'updatedAt',
          'usernameChangedAt'
        ])
        // New accounts must own the claim for their (lowercased) username.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.displayName.lower())).data.uid == request.auth.uid;

      allow update: if isSelf(uid)
        // The email mirrors the auth identity: it may be (re)written but only to
        // the address Firebase Auth says the caller owns.
        && request.resource.data.email == tokenEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'preferences',
          'onboarded', 'activeOrganizationId', 'organizationIds', 'updatedAt',
          'usernameChangedAt'
        ])
        && (
          request.resource.data.displayName == resource.data.displayName
          || (
            // Renaming: stamp the change, respect the three-month cooldown and
            // make sure the caller owns the claim for the new name.
            request.resource.data.usernameChangedAt == request.time
            && (
              resource.data.get('usernameChangedAt', null) == null
              || resource.data.get('usernameChangedAt', null) + duration.value(90, 'd') <= request.time
            )
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.displayName.lower())).data.uid == request.auth.uid
          )
        );

      allow delete: if false;

      /**
       * Denormalised membership index so the app can list a user's bands in one
       * read. The user themselves writes it when they accept an invite or leave
       * a band; the band's admins keep the mirrored role in step when they
       * change or remove a member — only that field, never the rest.
       */
      match /organizations/{organizationId} {
        allow read: if isSelf(uid)
          || (signedIn() && isAdmin(organizationId) && exists(memberPath(organizationId, uid)));
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['name', 'role', 'logoURL', 'joinedAt'])
          && request.resource.data.role in ['admin', 'member', 'guest']
          && (
            // the creator's own index entry for a band they just made
            isBandOwnerAfterBatch(organizationId)
            // an invitee's index entry while accepting an invitation
            || acceptedOwnInvitationAfterBatch(organizationId)
          );
        allow update: if (
            isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'logoURL', 'joinedAt'])
          ) || (
            signedIn()
            && isAdmin(organizationId)
            && exists(memberPath(organizationId, uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          );
        allow delete: if isSelf(uid)
          || (signedIn() && isAdmin(organizationId) && uid != request.auth.uid);
      }

      /**
       * Private reading preferences per song: the autoscroll speed and start
       * delay (roadmap #1), and later the scroll position and transpose (#4).
       * Owner-only — the band never reads how another member reads a song, and
       * none of it is ever written to the shared song document.
       */
      match /readerState/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validReaderState();
        allow delete: if isSelf(uid);
      }

      /**
       * Private annotations of one song (roadmap #3): free-form notes plus
       * inline markers anchored to lines. Owner-only — same trust model as the
       * reader state, and the shared song document is never touched.
       */
      match /annotations/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validAnnotation();
        allow delete: if isSelf(uid);
      }

      /**
       * Personal read marker of one band's activity feed (`users/{uid}/
       * activityRead/{orgId}`, roadmap #53): a single timestamp per user per
       * band — "everything up to here was read". Owner-only like the reader
       * state: it is a badge, never surveillance, so no other member (nor the
       * band document) can learn who has read what.
       */
      match /activityRead/{orgId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['lastActivityReadAt'])
          && request.resource.data.get('lastActivityReadAt', null) is timestamp;
        allow delete: if isSelf(uid);
      }

      /**
       * Personal favorites (`users/{uid}/favorites/{songId}`, roadmap #33): one
       * tiny document per starred song — the same per-song shape as readerState
       * and annotations. Owner-only: what another member stars is not band data,
       * and the shared song document is never touched. The body must mirror the
       * id, so a star can never claim to be a different song.
       */
      match /favorites/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['songId'])
          && request.resource.data.songId == songId;
        allow delete: if isSelf(uid);
      }

      /**
       * Private collections (`users/{uid}/collections/{collectionId}`, roadmap
       * #33): personal setlist drafts, never visible to other members. Names are
       * bounded and both lists are capped exactly where the client clamps them,
       * so a write the client can build is a write the rules accept.
       */
      match /collections/{collectionId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['name', 'songIds', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.songIds is list
          && request.resource.data.songIds.size() <= 500
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isSelf(uid);
      }

      /**
       * Push registrations (roadmap #52): one document per install, and its id
       * IS the Expo push token, so the body can never drift from its own key.
       * Owner-only both ways — another member must never read this device's
       * token — with a closed field list, so a client cannot smuggle anything
       * into the shape Cloud Functions fan out from. The fields are exactly
       * what `services/notifications.ts` writes (no `createdAt`: a merge write
       * would only re-stamp it).
       */
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'lang', 'lastSeenAt'])
          && request.resource.data.token is string
          && request.resource.data.token == deviceId
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.lang in ['en', 'es']
          && request.resource.data.lastSeenAt is timestamp;
      }

      /**
       * The Pro plan (roadmap #61): the entitlement document is written by
       * the `syncProPurchase` callable and **only read here**. The client
       * never writes it — there is no `allow write` at all — so a phone can
       * never grant itself the plan; the store has to confirm the purchase
       * first. The free plan needs no document: a missing one simply reads
       * as the free plan (`libs` side: `mapEntitlement`).
       */
      match /entitlements/{entitlementId} {
        allow read: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------- usernames
    //
    // Public (signed-in) registry of name claims, keyed by the lowercased name.
    // Claiming is an atomic create, so `Rixel` and `rixel` can never belong to
    // two accounts. Renames are a batch that claims the new key and releases the
    // old one (see `services/usernames.ts`).
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------- invitations (collection group)
    //
    // `subscribeMyInvitations` queries the "invitations" collection group to
    // find the invitee without knowing which band invited them. Collection
    // group queries only match rules declared with a recursive wildcard, so the
    // nested /organizations/{id}/invitations rule below is not enough on its
    // own: this grants invitees read access to their own invitation, and only
    // their own.
    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn()
        && validEmail(resource.data.email)
        && resource.data.email == tokenEmail();
    }

    // The requester finds their own asks across every band (roadmap #60),
    // exactly like the invitation query above. A document id cannot pin a
    // query (a collection-group query never constrains ids), so the ask's own
    // `uid` field is what keeps every result the caller's — the id is checked
    // by the nested rule for single-document reads instead.
    match /{path=**}/joinRequests/{requesterUid} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------ directory (#60)

    /**
     * The opt-in directory: the document's *existence* is the band's consent to
     * be found by name, and its contents stop at the name and its search key —
     * never emails, uids or rosters. Rules are not filters, so the exact-name
     * search is pinned through `resource.data.nameKey` (a where clause surfaces
     * as the document field it constrains, exactly like the invitation query's
     * email): a query that does not filter by the key cannot prove it holds for
     * every result, so only equality searches get through — each one names a
     * single band, which is what keeps the directory un-enumerable.
     */
    match /discoverable/{organizationId} {
      allow list: if signedIn()
        && resource.data.nameKey is string
        && resource.data.nameKey.size() >= 1
        && request.query.limit != null
        && request.query.limit <= 10
        && (request.query.offset == null || request.query.offset == 0);

      // Only an admin of that very band may publish or rename the entry, and
      // only while the band's own flag says so — the organization update below
      // pins the other direction, so the pair can never drift.
      allow create, update: if isAdmin(organizationId)
        && getAfter(organizationPath(organizationId)).data.get('discoverable', false) == true
        && request.resource.data.keys().hasOnly(['name', 'nameKey'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() >= 1
        && request.resource.data.nameKey.size() <= 80;

      // Removing the entry is what "opt out" means, so it only closes the loop:
      // the band's flag must read false after this batch — or the band itself
      // must be gone, which is the deletion cascade's own batch.
      allow delete: if isAdmin(organizationId)
        && (getAfter(organizationPath(organizationId)) == null
            || getAfter(organizationPath(organizationId)).data.get('discoverable', false) == false);
    }

    // ------------------------------------------------------------ organizations

    match /organizations/{organizationId} {
      allow read: if isBandReader(organizationId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'logoURL', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string;

      allow update: if isAdmin(organizationId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'logoURL', 'updatedAt', 'discoverable'])
        // Discoverability is a pair (roadmap #60): the flag only moves
        // together with its directory entry, in either direction.
        && discoverableFlagMatchesDirectory(organizationId, resource.data, request.resource.data);

      // Only the owner can delete the band.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // ------------------------------------------------------------- entitlement

      /**
       * The Pro plan (roadmap #61): the entitlement lives on the **band**,
       * because the band is what subscribes — an admin buys it and every
       * member of the band gets the perks (no ads on any of their devices, the
       * statistics, and no songbook ceiling).
       *
       * It is **written by the callable alone**: the store confirms the
       * purchase and the Admin SDK writes it, so there is no `allow write`
       * here at all and a phone can never grant a band the plan.
       */
      match /entitlement/{entitlementId} {
        allow read: if isBandReader(organizationId);
      }

      // ----------------------------------------------------------------- members

      match /members/{memberUid} {
        allow read: if isBandReader(organizationId);

        allow create: if request.resource.data.keys().hasOnly([
              'uid', 'displayName', 'email', 'photoURL', 'role', 'joinedAt', 'invitedBy'
            ])
            && request.resource.data.uid == memberUid
            && request.resource.data.role in ['admin', 'member', 'guest']
            && (
              // an admin adding somebody by hand
              isAdmin(organizationId)
              // the creator seeding their own membership for a band they just made
              || (isSelf(memberUid) && isBandOwnerAfterBatch(organizationId))
              // an invitee accepting their own invitation
              || (isSelf(memberUid) && acceptedOwnInvitationAfterBatch(organizationId))
            );

        // Admins manage other members; everyone keeps their own profile copy
        // (name, email, photo) in step with their account. The role and the uid
        // can never change from here, and the owner flag stays with the account
        // that created the band.
        allow update: if (
            isAdmin(organizationId)
            && memberUid != request.auth.uid
            && request.resource.data.uid == memberUid
            && request.resource.data.role in ['admin', 'member', 'guest']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'displayName', 'photoURL', 'email'])
          ) || (
            isSelf(memberUid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'email'])
          );

        // Nobody may remove themselves (an admin could lock the owner out) —
        // except the owner deleting the whole band, which removes every
        // membership, including their own, in the same batch as the organization.
        allow delete: if (isAdmin(organizationId) && memberUid != request.auth.uid)
          || ownerIsDeletingOrganization(organizationId);
      }

      // ------------------------------------------------------------- invitations

      match /invitations/{invitationId} {
        // Admins see every invitation; an invitee only ever sees their own.
        allow read: if isAdmin(organizationId)
          || (signedIn() && validEmail(resource.data.email) && resource.data.email == tokenEmail());

        allow create: if isAdmin(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'organizationName', 'email', 'role', 'status',
            'invitedBy', 'invitedByName', 'createdAt', 'respondedAt'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.role in ['admin', 'member', 'guest']
          && request.resource.data.status == 'pending'
          && validEmail(request.resource.data.email)
          // The document id is the lowercased email, otherwise the invitee could
          // never find their own invitation.
          && request.resource.data.email == invitationId;

        // Admins own invitations outright (re-invite, revoke, correct a role).
        // The invitee may only flip their own invitation to accepted, and only in
        // the same batch that creates their membership.
        allow update: if isAdmin(organizationId)
          || (signedIn()
              && resource.data.email == tokenEmail()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'respondedAt'])
              && request.resource.data.status == 'accepted'
              && getAfter(memberPath(organizationId, request.auth.uid)).data.role in ['admin', 'member', 'guest']);

        allow delete: if isAdmin(organizationId);
      }

      // --------------------------------------------------------- join requests

      // Roadmap #60: a musician asks to join an opt-in band. Approving turns
      // the ask into the ordinary invitation, so membership keeps the one rule
      // it has always had — only the account's own identity can join.
      match /joinRequests/{requesterUid} {
        // The requester reads their own ask; the band's admins review the rest.
        allow read: if isSelf(requesterUid) || isAdmin(organizationId);

        // Any signed-in account that is not already in the band may ask (a
        // guest has a member document, so they are out too), carrying only what
        // the admins need to recognise them: the requester's own name, their
        // own email and an optional note. Nothing of the band's rides along.
        allow create: if isSelf(requesterUid)
          && !exists(memberPath(organizationId, requesterUid))
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'email', 'note', 'createdAt', 'status'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && validEmail(request.resource.data.email)
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.createdAt is timestamp;

        // The requester may withdraw, cancel a rejection and ask again (a fresh
        // timestamp keeps the admin's ordering honest) — but never approve
        // themselves: the pending-only pin is what makes that impossible.
        allow update: if (
            isSelf(requesterUid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['note', 'createdAt', 'status'])
            && request.resource.data.status == 'pending'
          ) || (
            isAdmin(organizationId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.reviewedBy == request.auth.uid
          );

        allow delete: if isSelf(requesterUid) || isAdmin(organizationId);
      }

      // ------------------------------------------------------------------- songs

      match /songs/{songId} {
        allow read: if isBandReader(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 140
          && request.resource.data.sections is list
          // #40: attachments ride the same cap everywhere; `get()` keeps the
          // pin silent on documents written before the feature (absent → []).
          && request.resource.data.get('attachments', []) is list
          && request.resource.data.get('attachments', []).size() <= 20;
        allow update: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'artist', 'key', 'originalKey', 'capo', 'bpm', 'durationSec',
            'genre', 'notes', 'tags', 'sections', 'links', 'status', 'attachments',
            'deletedAt', 'deletedBy', 'authorId', 'authorName', 'updatedAt'
          ])
          // #40: the list is capped (rules cannot iterate it — its entries are
          // sanitized client-side in `libs/songAttachments.ts`, the `markers`
          // precedent). A partial update that never touches the field reads
          // the stored value (or the [] default) and sails through.
          && request.resource.data.get('attachments', []) is list
          && request.resource.data.get('attachments', []).size() <= 20;
        allow delete: if isAdmin(organizationId);

        // The song's version history (roadmap #26): one immutable document
        // per admin save, pruned past the cap by an admin delete. Members may
        // read the history — it holds no content the song itself hides.
        match /versions/{versionId} {
          allow read: if isMember(organizationId);
          allow create: if isAdmin(organizationId)
            && request.resource.data.keys().hasOnly(['data', 'savedAt', 'savedBy', 'savedByName'])
            && request.resource.data.data is map
            && request.resource.data.data.title is string
            && request.resource.data.data.title.size() > 0
            && request.resource.data.data.sections is list
            && request.resource.data.savedBy == request.auth.uid
            && request.resource.data.savedAt is timestamp;
          allow update: if false;
          allow delete: if isAdmin(organizationId);
        }

        // Edit presence (roadmap #28): a soft "X is editing" heartbeat, never
        // a lock. One dot per editor (id = uid) that only its own owner may
        // write — a guest has no editor door, so the writes sit behind
        // `isMember`, while the whole band may read who is inside. The clock
        // is client time: freshness is judged offline, and a serverTimestamp
        // would read null while a heartbeat queues.
        match /presence/{editorUid} {
          allow read: if isBandReader(organizationId);
          allow create, update: if isSelf(editorUid)
            && isMember(organizationId)
            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt'])
            && request.resource.data.uid == editorUid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 80
            && request.resource.data.updatedAt is timestamp;
          // The editor retires their own dot; an admin may sweep one left
          // behind by a crash that outlived its window.
          allow delete: if isSelf(editorUid) || isAdmin(organizationId);
        }
      }

      // ---------------------------------------------------------------- setlists

      match /setlists/{setlistId} {
        allow read: if isBandReader(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.songs is list;
        allow update: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'date', 'notes', 'songs', 'blocks',
            'estimatedDurationSec', 'targetMinutes', 'breakMinutes',
            'template', 'updatedAt'
          ]);
        allow delete: if isAdmin(organizationId);
      }

      // ------------------------------------------------------------ performances

      match /performances/{performanceId} {
        allow read: if isBandReader(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.date is string
          && request.resource.data.setlists is list
          && request.resource.data.venue is map
          && request.resource.data.status in ['scheduled', 'completed', 'cancelled']
          // The event type (roadmap #46) may be absent on an older client's
          // create — `mapPerformance` reads absence back as 'gig' — but a
          // present value must be one of the two.
          && (!('type' in request.resource.data)
            || request.resource.data.type in ['gig', 'rehearsal']);
        // Update: admins of this band (full edit) — the whitelist carries the
        // event fields plus `showLog`, the per-song outcome/time record that
        // the post-gig report writes (roadmap #45), `attendance`, the
        // uid → RSVP map (roadmap #47), and `liveShare`, the public live
        // setlist's link pointer (roadmap #57).
        //
        // Members get three narrow carve-outs: writing `showLog` alone (plus
        // the `updatedAt` touch that always rides a write) — whoever is
        // running the show marks songs from the reader even when they are not
        // an admin — writing `attendance` with **only their own key** changed,
        // one dot-path per member so two answers at once can never clobber
        // each other, or pointing the event at its live share link (roadmap
        // #57) — publishing the band's setlist to fans is a band decision,
        // not an admin job, exactly like #56's link minting. Operational data
        // about the night, not an edit of the event: every other field stays
        // admin-only.
        //
        // Rules cannot iterate the list or the map, so the document-level
        // shapes (list ≤ 500, map ≤ 100) are pinned here and each entry's
        // contents are sanitized client-side in `libs/showLog.ts` and
        // `libs/eventLogistics.ts` — the annotations' `markers` precedent
        // exactly.
        allow update: if (isAdmin(organizationId)
                          && request.resource.data.organizationId == organizationId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'name', 'date', 'endDate', 'startTime', 'endTime', 'venue', 'notes',
                            'setlists', 'status', 'type', 'updatedAt', 'showLog', 'attendance',
                            'liveShare'
                          ])
                          && (!('showLog' in request.resource.data)
                              || (request.resource.data.showLog is list
                                  && request.resource.data.showLog.size() <= 500))
                          && (!('attendance' in request.resource.data)
                              || (request.resource.data.attendance is map
                                  && request.resource.data.attendance.size() <= 100))
                          && (!('liveShare' in request.resource.data)
                              || validLiveShare(request.resource.data.liveShare)))
          || (isMember(organizationId)
              && ((request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['showLog', 'updatedAt'])
                   && request.resource.data.showLog is list
                   && request.resource.data.showLog.size() <= 500)
                  || (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['attendance', 'updatedAt'])
                      && request.resource.data.attendance is map
                      && request.resource.data.attendance.size() <= 100
                      && request.resource.data.attendance
                           .diff(resource.data.get('attendance', {}))
                           .affectedKeys().hasOnly([request.auth.uid])
                      && (!(request.auth.uid in request.resource.data.attendance)
                          || request.resource.data.attendance[request.auth.uid]
                               in ['yes', 'maybe', 'no']))
                  || (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['liveShare', 'updatedAt'])
                      && validLiveShare(request.resource.data.liveShare))));
        allow delete: if isAdmin(organizationId);

        // "Who brings what" (roadmap #47): one small document per thing to
        // bring, live-ticked by whoever has their hands on the list. Any
        // member writes them — logistics is not an admin job — but
        // `createdBy` is immutable at create time and only its creator (or an
        // admin) may delete one.
        match /tasks/{taskId} {
          // Read: guests too (roadmap #59) — a sub/tech needs to know what to
          // bring. Write stays below on `isMember`, so a guest cannot tick,
          // add or edit anything.
          allow read: if isBandReader(organizationId);
          allow create: if isMember(organizationId)
            && request.resource.data.keys().hasOnly([
              'title', 'assignedTo', 'done', 'createdBy', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() <= 128
            && request.resource.data.done is bool
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if isMember(organizationId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'assignedTo', 'done', 'updatedAt'])
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() <= 128
            && request.resource.data.done is bool
            && request.resource.data.createdBy == resource.data.createdBy;
          allow delete: if isAdmin(organizationId)
            || resource.data.createdBy == request.auth.uid;
        }
      }

      // ----------------------------------------------------------- date polls

      match /datePolls/{pollId} {
        allow read: if isMember(organizationId);

        // Any member may propose dates — logistics, not an admin job (#47's
        // own rule) — but the poll is born **open, with no winner and no
        // event**: closing it and stamping the winner is admin territory,
        // because that step is what turns the poll into an event.
        allow create: if isMember(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'title', 'options', 'status', 'winningOptionId',
            'createdEventId', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.title is string
          && request.resource.data.title.trim().size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.options is list
          && request.resource.data.options.size() >= 2
          && request.resource.data.options.size() <= 10
          && request.resource.data.status == 'open'
          && request.resource.data.winningOptionId == ''
          && request.resource.data.createdEventId == ''
          && request.resource.data.createdBy == request.auth.uid;

        // Admin edit only: the title and the dates stay fixable while the
        // poll is open, and `status`/`winningOptionId` carry the close while
        // `createdEventId` records the event born from the winner. Rules
        // cannot iterate the options list, so its document-level shape
        // (2..10 entries) is pinned here and each entry's contents are
        // sanitized client-side in `libs/datePolls.ts` — the annotations'
        // `markers` precedent exactly.
        allow update: if (isAdmin(organizationId)
                          && request.resource.data.organizationId == organizationId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'title', 'options', 'status', 'winningOptionId',
                            'createdEventId', 'updatedAt'
                          ])
                          && request.resource.data.title is string
                          && request.resource.data.title.trim().size() > 0
                          && request.resource.data.title.size() <= 120
                          && request.resource.data.options is list
                          && request.resource.data.options.size() >= 2
                          && request.resource.data.options.size() <= 10
                          && request.resource.data.status in ['open', 'closed']);
        allow delete: if isAdmin(organizationId)
          || resource.data.createdBy == request.auth.uid;

        // One availability doc per member (doc id = uid), the favorites
        // shape exactly: a member owns their answer alone, so two votes at
        // once can never clobber each other and nobody can vote for anyone
        // else. Option ids' contents are validated client-side — a stale id
        // counts for nothing (`libs/datePolls.ts`).
        match /votes/{voterUid} {
          allow read: if isMember(organizationId);
          allow create, update: if isMember(organizationId)
            && request.auth.uid == voterUid
            && request.resource.data.keys().hasOnly(['optionIds', 'updatedAt'])
            && request.resource.data.optionIds is list
            && request.resource.data.optionIds.size() <= 10;
          allow delete: if isMember(organizationId)
            && request.auth.uid == voterUid;
        }
      }

      // ---------------------------------------------------- reusable checklists

      match /checklists/{checklistId} {
        allow read: if isMember(organizationId);

        // Any member maintains the band's reusable checklists — logistics is
        // not an admin job (#47's rule again) — and one is born under its
        // author's name. `items` is a list of plain titles (gear, setup,
        // payments…); rules cannot iterate a list, so its document-level
        // shape (1..50 entries) is pinned here and each title is sanitized
        // client-side in `libs/checklistTemplates.ts` — the annotations'
        // `markers` precedent exactly. Attaching a checklist writes #47's
        // task documents, so that side needs no rule at all.
        allow create: if isMember(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'name', 'kind', 'items', 'createdBy',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.trim().size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.kind in ['gear', 'setup', 'payments', 'custom']
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 50
          && request.resource.data.createdBy == request.auth.uid;

        // Members edit the content (fix a typo, grow the list); the author
        // and the stamps never move, so the whitelist carries neither.
        allow update: if (isMember(organizationId)
                          && request.resource.data.organizationId == organizationId
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['name', 'kind', 'items', 'updatedAt'])
                          && request.resource.data.name is string
                          && request.resource.data.name.trim().size() > 0
                          && request.resource.data.name.size() <= 80
                          && request.resource.data.kind in ['gear', 'setup', 'payments', 'custom']
                          && request.resource.data.items is list
                          && request.resource.data.items.size() >= 1
                          && request.resource.data.items.size() <= 50);
        allow delete: if isAdmin(organizationId)
          || resource.data.createdBy == request.auth.uid;
      }

      // ------------------------------------------------------------- suggestions

      match /suggestions/{suggestionId} {
        allow read: if isMember(organizationId);

        // Every member may suggest a change, only ever under their own name and
        // only in the pending state.
        allow create: if isMember(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'songId', 'songTitle', 'authorId', 'authorName',
            'type', 'change', 'summary', 'comment', 'status', 'createdAt',
            'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Admins review; authors may still edit or withdraw their own pending
        // suggestion but cannot resolve it themselves.
        //
        // Lightweight assignments (roadmap #58) are the third door: any
        // member — the author included, "I'll take it" — may flip
        // `assigneeId` and nothing else, and only while the thread is open.
        // A field-level carve-out in the #57 `live` pointer's own shape; the
        // value is a uid or the empty string (unassign), and the rules cannot
        // walk the roster, so *whose* uid it is stays client-side — the
        // picker only ever offers real members.
        allow update: if (isAdmin(organizationId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'status', 'reviewedBy', 'reviewedByName', 'reviewedAt',
                            'reviewNote', 'songId', 'songTitle'
                          ])
                          && request.resource.data.status in ['pending', 'accepted', 'rejected'])
          || (isSelf(resource.data.authorId)
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['comment', 'summary', 'change', 'type', 'songTitle']))
          || (isMember(organizationId)
              && resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['assigneeId'])
              && request.resource.data.assigneeId is string
              && request.resource.data.assigneeId.size() <= 128);

        allow delete: if isAdmin(organizationId)
          || (isSelf(resource.data.authorId) && resource.data.status == 'pending');

        // Discussion thread (roadmap #55): one small document per comment,
        // author name denormalised, client-time `createdAt` so an offline
        // comment keeps its place. A comment is never edited — only removed,
        // by its author or an admin, and removal is a tombstone (the single
        // `deletedAt` transition) so the thread keeps its shape for everyone.
        // Hard delete exists for one caller: the parent suggestion cascading
        // its thread away in `deleteSuggestionComments` (the `deleteVersions`
        // precedent) — the UI itself only ever soft-deletes.
        match /comments/{commentId} {
          allow read: if isMember(organizationId);
          allow create: if isMember(organizationId)
            && request.resource.data.keys().hasOnly([
              'body', 'authorId', 'authorName', 'createdAt', 'deletedAt'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && request.resource.data.createdAt is timestamp
            && request.resource.data.deletedAt == null;
          allow update: if (isSelf(resource.data.authorId) || isAdmin(organizationId))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deletedAt'])
            && resource.data.deletedAt == null
            && request.resource.data.deletedAt is timestamp;
          allow delete: if isSelf(resource.data.authorId) || isAdmin(organizationId);
        }
      }

      // ---------------------------------------------------------------- activity

      match /activity/{eventId} {
        // Append-only feed: members add to it, nobody edits history.
        allow read: if isMember(organizationId);
        allow create: if isMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        // The feed stays append-only, except while the owner deletes the band.
        allow delete: if ownerIsDeletingOrganization(organizationId);
      }
    }

    // ---------------------------------------------------------------- shares
    //
    // Public share links (roadmap #56): `shares/{token}` holds a denormalized,
    // read-only snapshot of one song or setlist. The document is written only
    // by the `createShare` callable through the Admin SDK — which bypasses
    // these rules, and that is exactly why no write rule exists — and the
    // payload is rebuilt from the stored source document, so a client can never
    // publish fabricated content through it.
    //
    // Anyone holding the exact token may read it. An expired snapshot reads as
    // gone even though the document still exists (the app treats the resulting
    // denial exactly like a missing document), so a link stops working at its
    // deadline with nobody deleting it — deletion is what `revokeShare` does.
    // Listing stays closed: without a list the collection cannot be
    // enumerated, so holding the token is the only way in.
    match /shares/{token} {
      allow get: if resource == null
        || resource.data.get("expiresAt", null) == null
        || resource.data.get("expiresAt", null) > request.time;
      // The band's own clients keep the "current position" fresh while the
      // show runs (roadmap #57): one field-level update that may touch
      // `live` and nothing else, by a member of the owning band only. A
      // single-document listener is served by the `get` rule above — the
      // fan page subscribes — while create, delete and every other field
      // stay callable-owned and `list` stays closed, so holding the token
      // remains the only way in.
      allow update: if isMember(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['live'])
        && validShareLive(request.resource.data.get('live', null));
      allow list, create, delete: if false;
    }

    // ---------------------------------------------------------------- version
    //
    // Release marker: `AppUpdateGate` checks that the build's own record still
    // exists to detect a forced update, so reads stay public. Writes are denied
    // like everywhere else.
    match /version/{versionId} {
      allow read: if true;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}