rules_version = '2';

/**
 * Setuno — Firestore security rules (docs §23).
 *
 * Model recap:
 *   users/{uid}                                     profile + preferences
 *   users/{uid}/organizations/{organizationId}      membership index (role)
 *   users/{uid}/readerState/{songId}                private per-song reader state
 *   users/{uid}/annotations/{songId}                private per-song annotations
 *   users/{uid}/favorites/{songId}                 private star, one doc per song
 *   users/{uid}/collections/{collectionId}          private setlist drafts
 *   organizations/{organizationId}                  the band
 *   organizations/{organizationId}/members/{uid}
 *   organizations/{organizationId}/songs
 *   organizations/{organizationId}/setlists
 *   organizations/{organizationId}/performances
 *   organizations/{organizationId}/performances/{performanceId}/tasks
 *   organizations/{organizationId}/suggestions
 *   organizations/{organizationId}/activity
 *   organizations/{organizationId}/invitations/{lowercased email}
 *
 * Invariants enforced here:
 *   • only members can read anything inside their band;
 *   • only admins can write the *content* of songs, setlists or performances —
 *     members get two narrow event carve-outs (roadmap #45/#47): the show log
 *     and their own attendance answer, plus the event's tasks, which any
 *     member ticks (logistics is not an admin job);
 *   • any member can create a suggestion, nobody can edit a song directly;
 *   • nobody can change their own role, admins included;
 *   • membership is granted through an email-keyed invitation that only the
 *     matching authenticated account can accept, in the same batch that creates
 *     the membership;
 *   • `users/{uid}` is private: no client can look up another person's account,
 *     which is what keeps invite-by-email honest.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    /** Lowercased email on the auth token; the invitation key is built from it. */
    function tokenEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function memberPath(organizationId, uid) {
      return /databases/$(database)/documents/organizations/$(organizationId)/members/$(uid);
    }

    function organizationPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId);
    }

    function invitationPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/invitations/$(tokenEmail());
    }

    /** `get()` sees the state *before* a batch, so roles are read per request. */
    function roleOf(organizationId) {
      return exists(memberPath(organizationId, request.auth.uid))
        ? get(memberPath(organizationId, request.auth.uid)).data.role
        : null;
    }

    function isMember(organizationId) {
      return signedIn() && roleOf(organizationId) in ['admin', 'member'];
    }

    function isAdmin(organizationId) {
      return signedIn() && roleOf(organizationId) == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Creating the band and the owner's own membership happen in one batch, so
     * the membership check has to look at the post-batch organization.
     */
    function isBandOwnerAfterBatch(organizationId) {
      return getAfter(organizationPath(organizationId)).data.ownerId == request.auth.uid;
    }

    /** Accepting an invitation creates the membership in the same batch. */
    function acceptedOwnInvitationAfterBatch(organizationId) {
      return getAfter(invitationPath(organizationId)).data.status == 'accepted';
    }

    /**
     * True while the band's owner deletes the whole band in this batch. The
     * delete flow removes the memberships and the activity feed in the same
     * transaction that deletes the organization itself.
     */
    function ownerIsDeletingOrganization(organizationId) {
      return signedIn()
        && get(organizationPath(organizationId)).data.ownerId == request.auth.uid
        && getAfter(organizationPath(organizationId)) == null;
    }

    function validEmail(address) {
      return address is string && address.size() > 3 && address.size() <= 320
        && address.lower() == address
        && address.matches('.*@.*');
    }

    /**
     * Personal reader state of one song (`users/{uid}/readerState/{songId}`):
     * autoscroll settings plus the resume point (scroll position, transpose,
     * capo and text size, roadmap #1/#4/#5). Add any new field to this list and
     * to `validReaderState`, or the write is rejected.
     */
    function readerStateKeys() {
      return ['autoscrollSpeed', 'autoscrollDelay', 'scrollRatio', 'semitones', 'capo', 'fontSize'];
    }

    function validReaderState() {
      return request.resource.data.keys().hasOnly(readerStateKeys())
        && request.resource.data.get('autoscrollSpeed', 0) is number
        && request.resource.data.get('autoscrollDelay', 0) is number
        && request.resource.data.get('scrollRatio', 0) is number
        && request.resource.data.get('scrollRatio', 0) >= 0
        && request.resource.data.get('scrollRatio', 0) <= 1
        && request.resource.data.get('semitones', 0) is number
        && request.resource.data.get('semitones', 0) >= -11
        && request.resource.data.get('semitones', 0) <= 11
        && request.resource.data.get('capo', 0) is number
        && request.resource.data.get('capo', 0) >= 0
        && request.resource.data.get('capo', 0) <= 12
        && request.resource.data.get('fontSize', 13) is number
        && request.resource.data.get('fontSize', 13) >= 13
        && request.resource.data.get('fontSize', 13) <= 30;
    }

    /**
     * Personal song annotations (`users/{uid}/annotations/{songId}`, roadmap
     * #3). Owner-only, like the reader state: the band never reads another
     * member's notes, and none of it is ever written to the shared song
     * document. Markers are a list, so the rules pin the document-level shape
     * (types, sizes, limits) and leave each entry's contents to the client —
     * the rules language cannot iterate a list.
     */
    function annotationKeys() {
      return ['notes', 'markers', 'updatedAt'];
    }

    function validAnnotation() {
      return request.resource.data.keys().hasOnly(annotationKeys())
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 2000
        && request.resource.data.get('markers', []) is list
        && request.resource.data.get('markers', []).size() <= 50
        && request.resource.data.get('updatedAt', null) is timestamp;
    }

    // -------------------------------------------------------------------- users

    match /users/{uid} {
      // A profile is private: band membership is read through
      // `organizations/{id}/members`, never from here.
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'organizationIds',
          'activeOrganizationId', 'preferences', 'onboarded', 'createdAt', 'updatedAt',
          'usernameChangedAt'
        ])
        // New accounts must own the claim for their (lowercased) username.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.displayName.lower())).data.uid == request.auth.uid;

      allow update: if isSelf(uid)
        // The email mirrors the auth identity: it may be (re)written but only to
        // the address Firebase Auth says the caller owns.
        && request.resource.data.email == tokenEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'preferences',
          'onboarded', 'activeOrganizationId', 'organizationIds', 'updatedAt',
          'usernameChangedAt'
        ])
        && (
          request.resource.data.displayName == resource.data.displayName
          || (
            // Renaming: stamp the change, respect the three-month cooldown and
            // make sure the caller owns the claim for the new name.
            request.resource.data.usernameChangedAt == request.time
            && (
              resource.data.get('usernameChangedAt', null) == null
              || resource.data.get('usernameChangedAt', null) + duration.value(90, 'd') <= request.time
            )
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.displayName.lower())).data.uid == request.auth.uid
          )
        );

      allow delete: if false;

      /**
       * Denormalised membership index so the app can list a user's bands in one
       * read. The user themselves writes it when they accept an invite or leave
       * a band; the band's admins keep the mirrored role in step when they
       * change or remove a member — only that field, never the rest.
       */
      match /organizations/{organizationId} {
        allow read: if isSelf(uid)
          || (signedIn() && isAdmin(organizationId) && exists(memberPath(organizationId, uid)));
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['name', 'role', 'logoURL', 'joinedAt'])
          && request.resource.data.role in ['admin', 'member']
          && (
            // the creator's own index entry for a band they just made
            isBandOwnerAfterBatch(organizationId)
            // an invitee's index entry while accepting an invitation
            || acceptedOwnInvitationAfterBatch(organizationId)
          );
        allow update: if (
            isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'logoURL', 'joinedAt'])
          ) || (
            signedIn()
            && isAdmin(organizationId)
            && exists(memberPath(organizationId, uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          );
        allow delete: if isSelf(uid)
          || (signedIn() && isAdmin(organizationId) && uid != request.auth.uid);
      }

      /**
       * Private reading preferences per song: the autoscroll speed and start
       * delay (roadmap #1), and later the scroll position and transpose (#4).
       * Owner-only — the band never reads how another member reads a song, and
       * none of it is ever written to the shared song document.
       */
      match /readerState/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validReaderState();
        allow delete: if isSelf(uid);
      }

      /**
       * Private annotations of one song (roadmap #3): free-form notes plus
       * inline markers anchored to lines. Owner-only — same trust model as the
       * reader state, and the shared song document is never touched.
       */
      match /annotations/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validAnnotation();
        allow delete: if isSelf(uid);
      }

      /**
       * Personal read marker of one band's activity feed (`users/{uid}/
       * activityRead/{orgId}`, roadmap #53): a single timestamp per user per
       * band — "everything up to here was read". Owner-only like the reader
       * state: it is a badge, never surveillance, so no other member (nor the
       * band document) can learn who has read what.
       */
      match /activityRead/{orgId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['lastActivityReadAt'])
          && request.resource.data.get('lastActivityReadAt', null) is timestamp;
        allow delete: if isSelf(uid);
      }

      /**
       * Personal favorites (`users/{uid}/favorites/{songId}`, roadmap #33): one
       * tiny document per starred song — the same per-song shape as readerState
       * and annotations. Owner-only: what another member stars is not band data,
       * and the shared song document is never touched. The body must mirror the
       * id, so a star can never claim to be a different song.
       */
      match /favorites/{songId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['songId'])
          && request.resource.data.songId == songId;
        allow delete: if isSelf(uid);
      }

      /**
       * Private collections (`users/{uid}/collections/{collectionId}`, roadmap
       * #33): personal setlist drafts, never visible to other members. Names are
       * bounded and both lists are capped exactly where the client clamps them,
       * so a write the client can build is a write the rules accept.
       */
      match /collections/{collectionId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['name', 'songIds', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.songIds is list
          && request.resource.data.songIds.size() <= 500
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------- usernames
    //
    // Public (signed-in) registry of name claims, keyed by the lowercased name.
    // Claiming is an atomic create, so `Rixel` and `rixel` can never belong to
    // two accounts. Renames are a batch that claims the new key and releases the
    // old one (see `services/usernames.ts`).
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------- invitations (collection group)
    //
    // `subscribeMyInvitations` queries the "invitations" collection group to
    // find the invitee without knowing which band invited them. Collection
    // group queries only match rules declared with a recursive wildcard, so the
    // nested /organizations/{id}/invitations rule below is not enough on its
    // own: this grants invitees read access to their own invitation, and only
    // their own.
    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn()
        && validEmail(resource.data.email)
        && resource.data.email == tokenEmail();
    }

    // ------------------------------------------------------------ organizations

    match /organizations/{organizationId} {
      allow read: if isMember(organizationId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'logoURL', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string;

      allow update: if isAdmin(organizationId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'logoURL', 'updatedAt']);

      // Only the owner can delete the band.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // ----------------------------------------------------------------- members

      match /members/{memberUid} {
        allow read: if isMember(organizationId);

        allow create: if request.resource.data.keys().hasOnly([
              'uid', 'displayName', 'email', 'photoURL', 'role', 'joinedAt', 'invitedBy'
            ])
            && request.resource.data.uid == memberUid
            && request.resource.data.role in ['admin', 'member']
            && (
              // an admin adding somebody by hand
              isAdmin(organizationId)
              // the creator seeding their own membership for a band they just made
              || (isSelf(memberUid) && isBandOwnerAfterBatch(organizationId))
              // an invitee accepting their own invitation
              || (isSelf(memberUid) && acceptedOwnInvitationAfterBatch(organizationId))
            );

        // Admins manage other members; everyone keeps their own profile copy
        // (name, email, photo) in step with their account. The role and the uid
        // can never change from here, and the owner flag stays with the account
        // that created the band.
        allow update: if (
            isAdmin(organizationId)
            && memberUid != request.auth.uid
            && request.resource.data.uid == memberUid
            && request.resource.data.role in ['admin', 'member']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'displayName', 'photoURL', 'email'])
          ) || (
            isSelf(memberUid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'email'])
          );

        // Nobody may remove themselves (an admin could lock the owner out) —
        // except the owner deleting the whole band, which removes every
        // membership, including their own, in the same batch as the organization.
        allow delete: if (isAdmin(organizationId) && memberUid != request.auth.uid)
          || ownerIsDeletingOrganization(organizationId);
      }

      // ------------------------------------------------------------- invitations

      match /invitations/{invitationId} {
        // Admins see every invitation; an invitee only ever sees their own.
        allow read: if isAdmin(organizationId)
          || (signedIn() && validEmail(resource.data.email) && resource.data.email == tokenEmail());

        allow create: if isAdmin(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'organizationName', 'email', 'role', 'status',
            'invitedBy', 'invitedByName', 'createdAt', 'respondedAt'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.status == 'pending'
          && validEmail(request.resource.data.email)
          // The document id is the lowercased email, otherwise the invitee could
          // never find their own invitation.
          && request.resource.data.email == invitationId;

        // Admins own invitations outright (re-invite, revoke, correct a role).
        // The invitee may only flip their own invitation to accepted, and only in
        // the same batch that creates their membership.
        allow update: if isAdmin(organizationId)
          || (signedIn()
              && resource.data.email == tokenEmail()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'respondedAt'])
              && request.resource.data.status == 'accepted'
              && getAfter(memberPath(organizationId, request.auth.uid)).data.role in ['admin', 'member']);

        allow delete: if isAdmin(organizationId);
      }

      // ------------------------------------------------------------------- songs

      match /songs/{songId} {
        allow read: if isMember(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 140
          && request.resource.data.sections is list;
        allow update: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'artist', 'key', 'originalKey', 'capo', 'bpm', 'durationSec',
            'genre', 'notes', 'tags', 'sections', 'links', 'status',
            'deletedAt', 'deletedBy', 'authorId', 'authorName', 'updatedAt'
          ]);
        allow delete: if isAdmin(organizationId);

        // The song's version history (roadmap #26): one immutable document
        // per admin save, pruned past the cap by an admin delete. Members may
        // read the history — it holds no content the song itself hides.
        match /versions/{versionId} {
          allow read: if isMember(organizationId);
          allow create: if isAdmin(organizationId)
            && request.resource.data.keys().hasOnly(['data', 'savedAt', 'savedBy', 'savedByName'])
            && request.resource.data.data is map
            && request.resource.data.data.title is string
            && request.resource.data.data.title.size() > 0
            && request.resource.data.data.sections is list
            && request.resource.data.savedBy == request.auth.uid
            && request.resource.data.savedAt is timestamp;
          allow update: if false;
          allow delete: if isAdmin(organizationId);
        }
      }

      // ---------------------------------------------------------------- setlists

      match /setlists/{setlistId} {
        allow read: if isMember(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.songs is list;
        allow update: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'date', 'notes', 'songs', 'blocks',
            'estimatedDurationSec', 'targetMinutes', 'breakMinutes',
            'template', 'updatedAt'
          ]);
        allow delete: if isAdmin(organizationId);
      }

      // ------------------------------------------------------------ performances

      match /performances/{performanceId} {
        allow read: if isMember(organizationId);
        allow create: if isAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.date is string
          && request.resource.data.setlists is list
          && request.resource.data.venue is map
          && request.resource.data.status in ['scheduled', 'completed', 'cancelled']
          // The event type (roadmap #46) may be absent on an older client's
          // create — `mapPerformance` reads absence back as 'gig' — but a
          // present value must be one of the two.
          && (!('type' in request.resource.data)
            || request.resource.data.type in ['gig', 'rehearsal']);
        // Update: admins of this band (full edit) — the whitelist carries the
        // event fields plus `showLog`, the per-song outcome/time record that
        // the post-gig report writes (roadmap #45), and `attendance`, the
        // uid → RSVP map (roadmap #47).
        //
        // Members get two narrow carve-outs: writing `showLog` alone (plus the
        // `updatedAt` touch that always rides a write) — whoever is running the
        // show marks songs from the reader even when they are not an admin —
        // or writing `attendance` with **only their own key** changed, one
        // dot-path per member so two answers at once can never clobber each
        // other. Operational data about the night, not an edit of the event:
        // every other field stays admin-only.
        //
        // Rules cannot iterate the list or the map, so the document-level
        // shapes (list ≤ 500, map ≤ 100) are pinned here and each entry's
        // contents are sanitized client-side in `libs/showLog.ts` and
        // `libs/eventLogistics.ts` — the annotations' `markers` precedent
        // exactly.
        allow update: if (isAdmin(organizationId)
                          && request.resource.data.organizationId == organizationId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'name', 'date', 'endDate', 'startTime', 'endTime', 'venue', 'notes',
                            'setlists', 'status', 'type', 'updatedAt', 'showLog', 'attendance'
                          ])
                          && (!('showLog' in request.resource.data)
                              || (request.resource.data.showLog is list
                                  && request.resource.data.showLog.size() <= 500))
                          && (!('attendance' in request.resource.data)
                              || (request.resource.data.attendance is map
                                  && request.resource.data.attendance.size() <= 100)))
          || (isMember(organizationId)
              && ((request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['showLog', 'updatedAt'])
                   && request.resource.data.showLog is list
                   && request.resource.data.showLog.size() <= 500)
                  || (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['attendance', 'updatedAt'])
                      && request.resource.data.attendance is map
                      && request.resource.data.attendance.size() <= 100
                      && request.resource.data.attendance
                           .diff(resource.data.get('attendance', {}))
                           .affectedKeys().hasOnly([request.auth.uid])
                      && (!request.resource.data.attendance.containsKey(request.auth.uid)
                          || request.resource.data.attendance[request.auth.uid]
                               in ['yes', 'maybe', 'no']))));
        allow delete: if isAdmin(organizationId);

        // "Who brings what" (roadmap #47): one small document per thing to
        // bring, live-ticked by whoever has their hands on the list. Any
        // member writes them — logistics is not an admin job — but
        // `createdBy` is immutable at create time and only its creator (or an
        // admin) may delete one.
        match /tasks/{taskId} {
          allow read: if isMember(organizationId);
          allow create: if isMember(organizationId)
            && request.resource.data.keys().hasOnly([
              'title', 'assignedTo', 'done', 'createdBy', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() <= 128
            && request.resource.data.done is bool
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if isMember(organizationId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'assignedTo', 'done', 'updatedAt'])
            && request.resource.data.title is string
            && request.resource.data.title.trim().size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() <= 128
            && request.resource.data.done is bool
            && request.resource.data.createdBy == resource.data.createdBy;
          allow delete: if isAdmin(organizationId)
            || resource.data.createdBy == request.auth.uid;
        }
      }

      // ------------------------------------------------------------- suggestions

      match /suggestions/{suggestionId} {
        allow read: if isMember(organizationId);

        // Every member may suggest a change, only ever under their own name and
        // only in the pending state.
        allow create: if isMember(organizationId)
          && request.resource.data.keys().hasOnly([
            'organizationId', 'songId', 'songTitle', 'authorId', 'authorName',
            'type', 'change', 'summary', 'comment', 'status', 'createdAt',
            'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
          ])
          && request.resource.data.organizationId == organizationId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Admins review; authors may still edit or withdraw their own pending
        // suggestion but cannot resolve it themselves.
        allow update: if (isAdmin(organizationId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'status', 'reviewedBy', 'reviewedByName', 'reviewedAt',
                            'reviewNote', 'songId', 'songTitle'
                          ])
                          && request.resource.data.status in ['pending', 'accepted', 'rejected'])
          || (isSelf(resource.data.authorId)
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['comment', 'summary', 'change', 'type', 'songTitle']));

        allow delete: if isAdmin(organizationId)
          || (isSelf(resource.data.authorId) && resource.data.status == 'pending');
      }

      // ---------------------------------------------------------------- activity

      match /activity/{eventId} {
        // Append-only feed: members add to it, nobody edits history.
        allow read: if isMember(organizationId);
        allow create: if isMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        // The feed stays append-only, except while the owner deletes the band.
        allow delete: if ownerIsDeletingOrganization(organizationId);
      }
    }

    // ---------------------------------------------------------------- version
    //
    // Release marker: `AppUpdateGate` checks that the build's own record still
    // exists to detect a forced update, so reads stay public. Writes are denied
    // like everywhere else.
    match /version/{versionId} {
      allow read: if true;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}